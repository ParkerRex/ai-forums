{
	"name": "vai",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"clean": "turbo run clean && rm -rf node_modules",
		"check-types": "turbo run check-types",
		"lint": "npx ultracite@latest lint",
		"format": "npx ultracite@latest format"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.2",
		"husky": "9.1.7",
		"turbo": "2.5.4",
		"typescript": "5.8.3",
		"ultracite": "5.0.48"
	},
	"engines": {
		"node": ">=18.8.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"packageManager": "bun@1.2.18"
}
